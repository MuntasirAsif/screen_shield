<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Install-time permission that enables WindowManager.addScreenRecordingCallback
       on API 35+ (Android 15). Restricted on Google Play: provide a privacy
       justification when publishing. -->
  <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING"/>

  <!-- Install-time permission that enables Activity.registerScreenCaptureCallback
       on API 34+ (Android 14). Only meaningful while blocking (FLAG_SECURE) is
       disabled, because the OS suppresses the callback on secured windows. -->
  <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE"/>
</manifest>
